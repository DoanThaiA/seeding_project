# Worker image with Chromium for the fb-web connector (worker-browser). Build context = repo root.
# NOT TESTED in this repository's CI (no Docker on the dev machine): build it once on the worker host
# and use `pnpm fb:login` to set up the account session.
FROM node:20.19-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates fonts-noto fonts-noto-color-emoji && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc tsconfig.base.json tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile && DATABASE_URL=postgresql://build@localhost/build pnpm db:generate

# Chromium + its system libraries, installed to a fixed shared path (needs root).
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN cd packages/connectors/fb-web && npx playwright-core install --with-deps chromium && chmod -R a+rX /ms-playwright

ENV NODE_ENV=production
# Browser profiles are mounted at /profiles (encrypted disk on the host).
RUN mkdir -p /profiles && chown node:node /profiles
USER node
CMD ["node", "--import", "tsx", "apps/worker-browser/src/main.ts"]
